  "query": "\nSELECT\n    p.port_id AS \"id!\",\n    p.name,\n    p.latitude,\n    p.longitude\nFROM\n    ports AS p\nWHERE\n    (\n        $1::TEXT IS NULL\n        OR p.port_id = $1\n    )\n            ",
